# Copy to .env on the Pi and chmod 600. Never commit the real .env.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# WAKE_PHRASES=hey gemini,hey assistant
# IDLE_TIMEOUT=8.0
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_API_VERSION=v1beta
# GEMINI_VOICE=Kore   # female: Kore, Aoede, Leda, Zephyr; male: Puck, Charon, Fenrir
# AUDIO_IN_DEVICE=      # index or name substring; see: python -m assistant --list-devices
# AUDIO_OUT_DEVICE=
# GREETING_EN=Online   # spoken (robot voice) after the chime; keep it to one short word; empty = no greeting
# GREETING_SV=Ja?
# GREETING_SPEED=115   # greeting speech speed in words per minute; lower = slower (default speech is 150)
# GREETING_MAP=hey gemini:en,hey assistant:en   # which wake phrase gets which greeting language (sv or en)
# READY_CHIME=true     # rising arpeggio once at startup: the assistant is up and waiting for the wake phrase
# IDLE_CHIME=true      # falling chime when a conversation ends after the idle timeout
# FAMILY_CONTEXT=...   # who the assistant is for (default: the Virgin Wiberg family: Kay, Rebecka, Morris, Milton); empty = none
# GREETING_SOURCE=gemini # who says the wake greeting: gemini (default), robot (espeak, instant) or off
# GEMINI_GREETING_EN=Yes?  GEMINI_GREETING_SV=Ja?   # what Gemini says
# ECHO_DEBUG=true       # log the echo gate's numbers while it speaks ([Gate] lines), for tuning BARGE_IN_MARGIN
# TIMER_TOOL=true      # voice timers: "sätt en timer på fem minuter"
# SLEEP_TOOL=true      # saying "go to sleep" ends the conversation at once
# GOOGLE_SEARCH=true   # let Gemini search the web for current facts; set false to turn off
# WAKE_CONFIRM_MS=200   # confirm a wake match with a final result this many ms later; 0 = off (faster, more false triggers); 500 = strictest
# WAKE_SKIP_MS=600   # audio dropped after the chime so the wake phrase's tail is not sent to Gemini
# FEEDBACK_LANG=sv   # spoken error messages: sv or en
# ERROR_VOICE=true   # speak errors (needs: sudo apt install espeak-ng); tones always play
# SPEECH_RMS=500   # mic level counted as speech for the idle timer
# ECHO_MODE=gate   # gate = hear you over its own voice so you can interrupt (default); mute = ignore the mic while it speaks; off = headphones
# BARGE_IN_MARGIN=2.0   # gate: how many times louder than the expected echo you must be to interrupt (lower = easier)
# MUTE_TAIL_MS=600   # keep ignoring the mic this long after the speaker stops (only while muting)
# MUTE_MIC_WHILE_SPEAKING=false   # set true if the speaker echo makes the assistant interrupt itself
